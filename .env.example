# centaur-lab cluster bootstrap secrets — TEMPLATE.
#
# Setup:
#   1. cp .env.example .env
#   2. Replace each <PLACEHOLDER> with a real value (see comments below).
#   3. ./scripts/bootstrap-secrets.sh
#
# DO NOT commit .env. It is gitignored.
#
# This file IS the schema. The bootstrap script reads every `export KEY=`
# line and writes one Secret entry per key. Add a new tool credential?
# Add the export here, add it to .env, re-run bootstrap-secrets.sh.
#
# To generate random hex tokens (the placeholders that say "openssl rand"):
#   openssl rand -hex 32
# Run once, paste the result, never rotate again unless you're rebuilding
# the cluster from scratch.

# === Required: harness credentials ===
# defaultHarness in values/centaur.yaml is `claude-code` so the Anthropic
# key is the only strict requirement. OpenAI is optional unless you switch
# harnesses or run OpenAI-backed BFTS variants.
export ANTHROPIC_API_KEY=<sk-ant-api03-...>
export OPENAI_API_KEY=<sk-proj-...>

# === Required: Slack integration (slackbot.enabled=true) ===
# From https://api.slack.com/apps/<your-app-id>:
#   - SLACK_BOT_TOKEN: OAuth & Permissions → Bot User OAuth Token (xoxb-…)
#   - SLACK_SIGNING_SECRET: Basic Information → App Credentials → Signing Secret
#   - SLACK_ETL_TOKEN: User-token install (xoxp-…) with channels:history,
#     groups:history, im:history, mpim:history, search:read scopes
export SLACK_BOT_TOKEN=<xoxb-...>
export SLACK_SIGNING_SECRET=<32-char-hex>
export SLACK_ETL_TOKEN=<xoxp-...>

# Slackbot ↔ API shared secret. `openssl rand -hex 32` is fine; treat as
# long-lived (rotating means rotating wherever else you use it).
export SLACKBOT_API_KEY=<openssl rand -hex 32>

# === Required: GitHub repo-cache ===
# Personal access token with `repo` scope (classic) or fine-grained PAT
# with Contents: Read on the repos listed under repoCache.repositories
# in values/centaur.yaml.
export GITHUB_TOKEN=<github_pat_...>

# === Optional: API admin/operator key ===
# Long-lived bearer for /admin/*, /workflows/*. Auto-bootstrapped into
# Postgres as the `service:local-dev` row. Use as -H "x-api-key: $LOCAL_DEV_API_KEY".
#   echo "aiv2_$(openssl rand -hex 24)"
export LOCAL_DEV_API_KEY=<aiv2_…>

# === Optional: tool credentials (per-tool) ===
# Add one `export TOOL_KEY=...` line per tool plugin in your overlay.
# Tools declare which env vars iron-proxy substitutes via their pyproject
# `[tool.centaur].secrets` / `optional_secrets` blocks.
export SEMANTIC_SCHOLAR_API_KEY=<s2k-…-or-empty>
# archiver tool (Reducto PDF/HTML → structured text). Without this set,
# the tool still registers at API startup but every call returns a
# credential error from iron-proxy. Get a key at https://reducto.ai/.
export REDUCTO_API_KEY=<reducto_…>
# websearch tool (Exa /search + /deep_research). Same register-but-error
# behavior as REDUCTO_API_KEY when missing. Key at https://exa.ai/.
export EXA_API_KEY=<exa_…>

# === Optional: 1Password (only used when secretSource=onepassword) ===
# In env mode (our setting), these sit unused in the Secret. The original
# upstream bootstrap script's require_env demanded them, so populate with
# random hex if you don't have a real 1Password setup.
export OP_SERVICE_ACCOUNT_TOKEN=<openssl rand -hex 32>
export OP_VAULT=<openssl rand -hex 32>

# === Random hex — generate once, never rotate ===
# These get written into Postgres / signing logic on first deploy.
# Rotating them invalidates existing data; only regenerate on a fresh cluster.
export IRON_MANAGEMENT_API_KEY=<openssl rand -hex 32>
export SANDBOX_SIGNING_KEY=<openssl rand -hex 32>
export POSTGRES_PASSWORD=<openssl rand -hex 32>

# DATABASE_URL embeds POSTGRES_PASSWORD via bash variable expansion at
# source-time. Leave the line exactly like this; the password fills in
# automatically when bootstrap-secrets.sh sources .env.
export DATABASE_URL="postgresql://tempo:${POSTGRES_PASSWORD}@centaur-centaur-postgres:5432/ai_v2"

# === Tooling (not written to the in-cluster Secret) ===
# Skipped by bootstrap-secrets.sh's SKIP_KEYS list.
export CENTAUR_NAMESPACE=centaur-system
