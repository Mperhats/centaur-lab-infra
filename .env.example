# centaur-lab cluster bootstrap secrets — TEMPLATE.
#
# Onboarding:
#   1. cp .env.example .env
#   2. Replace each <PLACEHOLDER> with a real value (see comments below).
#   3. source .env
#   4. ./scripts/bootstrap-secrets.sh
#   5. Continue with Argo CD bootstrap (see README.md).
#
# DO NOT commit .env. It is gitignored.
#
# The `export` prefix matters — bootstrap-secrets.sh loads this file with
# `set -a && source` so bare KEY=value lines also work, but `export` is
# explicit and survives interactive shell-sourcing for `just`-style flows.
#
# Note on auto-generated keys: SANDBOX_SIGNING_KEY, IRON_MANAGEMENT_API_KEY,
# POSTGRES_PASSWORD, and DATABASE_URL are not listed here. The bootstrap
# script generates random hex for them on first run and they persist in
# the in-cluster Secret thereafter.

# === Required: harness credentials (model API access) ===
# `defaultHarness` in values/centaur.yaml is `claude-code` so the Anthropic
# key is the strict requirement. OpenAI is optional unless you switch
# harnesses or run OpenAI-backed BFTS variants.
export ANTHROPIC_API_KEY=<sk-ant-api03-...>
export OPENAI_API_KEY=<sk-proj-...>

# === Required: Slack integration (slackbot.enabled=true) ===
# From your Slack app config: https://api.slack.com/apps/<your-app-id>
#   - Bot token: OAuth & Permissions → Bot User OAuth Token (xoxb-…)
#   - Signing secret: Basic Information → App Credentials → Signing Secret
export SLACK_BOT_TOKEN=<xoxb-...>
export SLACK_SIGNING_SECRET=<32-char-hex>

# Slack ETL backfill token (api.slackEtlEnabled=true).
# User token (xoxp-…) with channels:history, groups:history, im:history,
# mpim:history, search:read scopes. Created via the same Slack app as a
# user-token install.
export SLACK_ETL_TOKEN=<xoxp-...>

# Slackbot ↔ API shared secret. Any random string; bootstrap-secrets.sh does
# NOT generate this for you because rotating it requires also rotating it on
# the Slack-app side. Generate once and treat as long-lived.
#   openssl rand -hex 32
export SLACKBOT_API_KEY=<random-hex-32>

# === Required: GitHub access for repo-cache ===
# repoCache.enabled=true with `Mperhats/centaur-lab` as the synced repo.
# Personal access token (classic) with `repo` scope, OR fine-grained PAT
# with Contents: Read on the centaur-lab repo.
export GITHUB_TOKEN=<github_pat_...>

# === Required by upstream bootstrap, vestigial in env mode ===
# Iron-proxy uses these only when secretSource=onepassword(-connect). With
# secretSource=env (our setting), they sit unused in the Secret. The upstream
# bootstrap script's `require_env` checks fail without them, so populate with
# anything — random hex is fine.
#   openssl rand -hex 32
export OP_SERVICE_ACCOUNT_TOKEN=<random-hex-32-or-real-1password-sa-token>
export OP_VAULT=<random-hex-32-or-real-1password-vault-id>

# === Optional: API admin/operator key ===
# Long-lived bearer for /admin/*, /workflows/*, etc. Auto-bootstrapped into
# Postgres as the `service:local-dev` row on api startup.
#   echo "aiv2_$(openssl rand -hex 24)"
# Use as: curl -H "x-api-key: $LOCAL_DEV_API_KEY" ...
export LOCAL_DEV_API_KEY=<aiv2_...>

# === Optional: tool-specific credentials ===
# Semantic Scholar Graph API key. Leave as <empty> to use the anonymous
# (rate-limited) tier. Apply for higher quota:
# https://www.semanticscholar.org/product/api#api-key-form
export SEMANTIC_SCHOLAR_API_KEY=<s2k-...-or-empty>

# === Tooling (not part of the in-cluster Secret) ===
# Default namespace for `just`/`make`/`kubectl` recipes that are namespace-
# aware. Override the upstream default of `centaur` so passthrough commands
# target the same namespace bootstrap-secrets.sh writes to.
export CENTAUR_NAMESPACE=centaur-system
